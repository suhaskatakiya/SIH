# =====================================================================
# ROOT / BACKEND ENV  —  SERVER-SIDE ONLY. Never expose to the browser.
# Used by the Supabase CLI, Edge Functions (local), and DB/RLS tests.
# Copy to `.env` and fill in after you create your Supabase project.
# (Not needed at all while the frontend runs in mock mode.)
# =====================================================================

# Supabase project REST URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Public anon key (safe in browser, but the frontend does not need it in Phase 1)
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Service-role key — FULL ACCESS. Server-side only. NEVER put this in apps/web.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
