{
  "name": "cropsaathi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --filter @cropsaathi/contracts build && pnpm --filter @cropsaathi/web dev",
    "build": "pnpm --filter @cropsaathi/contracts build && pnpm --filter @cropsaathi/web build",
    "check": "pnpm --filter @cropsaathi/contracts build && pnpm --filter @cropsaathi/web check",
    "test": "pnpm --filter @cropsaathi/contracts test",
    "contracts:build": "pnpm --filter @cropsaathi/contracts build",
    "contracts:sync": "node scripts/sync-contracts.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
