# =====================================================================
# FRONTEND ENV (apps/web). PUBLIC_ vars are exposed to the browser.
# The site runs fully in MOCK mode with no backend — this is the default.
# =====================================================================

# "mock"  -> in-browser demo backend seeded with the SIH fixture (no Supabase).
# "live"  -> talk to the real Hono API on Supabase Edge Functions.
PUBLIC_API_MODE=mock

# Only used when PUBLIC_API_MODE=live.
# Point at your Supabase Edge Functions base (NO trailing slash, NO /api):
#   https://<your-project-ref>.supabase.co/functions/v1
# The app appends /api/v1/... itself.
PUBLIC_API_BASE_URL=
